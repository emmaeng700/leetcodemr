{
  "name": "leetcodemr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run grind:questions && npm run grind:editor && next build",
    "grind:questions": "npx --yes tsx scripts/generate-grind-questions.ts",
    "grind:scrape-missing": "python3 scripts/scrape_grind_missing_starters.py",
    "grind:editor": "npx --yes esbuild scripts/grind-offline-editor-entry.ts --bundle --format=iife --platform=browser --target=es2020 --minify --legal-comments=none --outfile=public/grind-offline-editor.js",
    "start": "next start",
    "lint": "eslint",
    "lc:connector": "node scripts/leetcode-connector.js",
    "lc:auth": "node scripts/leetcode-connector.js auth",
    "lc:import": "node scripts/leetcode-connector.js import",
    "playbook": "python3 scripts/generate_playbook_json.py"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "@types/canvas-confetti": "^1.9.0",
    "@uiw/react-codemirror": "^4.25.8",
    "canvas-confetti": "^1.9.4",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "playwright": "^1.54.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
